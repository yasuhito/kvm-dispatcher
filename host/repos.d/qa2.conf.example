# Adapter contract for qniapp/qa2. The repo itself ships the template unit.
KVM_DISPATCHER_REPO=qniapp/qa2
KVM_DISPATCHER_INSTALLATION=qniapp
KVM_DISPATCHER_LABELS=qa2-kvm
KVM_DISPATCHER_UNIT=qa2-runner-job@
KVM_DISPATCHER_RUNNER_NAME_PREFIX=qa2-kvm-
KVM_DISPATCHER_MAX_UNIT_SECONDS=5400
KVM_DISPATCHER_MEMORY_MIB=12288
KVM_DISPATCHER_CONCURRENCY=1
