# Adapter contract for qorraq/qoral. The repo itself ships the template unit.
KVM_DISPATCHER_REPO=qorraq/qoral
KVM_DISPATCHER_INSTALLATION=qorraq
KVM_DISPATCHER_LABELS=qoral-kvm
KVM_DISPATCHER_UNIT=qoral-runner-job@
KVM_DISPATCHER_RUNNER_NAME_PREFIX=qoral-kvm-
KVM_DISPATCHER_MAX_UNIT_SECONDS=19800
KVM_DISPATCHER_MEMORY_MIB=12288
KVM_DISPATCHER_CONCURRENCY=1
